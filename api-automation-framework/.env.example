# Environment selected when pytest is run without --env.
TEST_ENV=test

# Optional overrides. Leave commented to use config/config.yaml values.
# API_BASE_URL=http://127.0.0.1:8000
# API_TIMEOUT=10

# Required only by tests that perform MySQL assertions.
DB_HOST=127.0.0.1
DB_PORT=3308
DB_USER=api_test_user
DB_PASSWORD=replace_with_a_local_password
DB_NAME=api_test
DB_CONNECT_TIMEOUT=3
